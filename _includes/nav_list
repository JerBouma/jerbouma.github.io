{% assign navigation = site.data.navigation[include.nav] %}

<nav class="nav__list">
  {% if page.sidebar.title %}<h3 class="nav__title" style="padding-left: 0;">{{ page.sidebar.title }}</h3>{% endif %}
  {% if page.sidebar.hint %}<p class="nav__hint"><i class="fas fa-list-ul" aria-hidden="true"></i> {{ page.sidebar.hint }}</p>{% endif %}
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ page.sidebar.menu_label | default: site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    {% for nav in navigation %}
      <li>
        {% if nav.children != null %}
        <details class="nav__collapsible{% if nav.title == "Modules" %} nav__collapsible--modules{% endif %}"{% unless nav.title == "Modules" %} open{% endunless %}>
          {% if nav.url %}
            <summary class="nav__sub-title nav__collapsible-title"><a href="{{ nav.url | relative_url }}">{{ nav.title }}</a></summary>
          {% else %}
            <summary class="nav__sub-title nav__collapsible-title">{{ nav.title }}</summary>
          {% endif %}
          <ul>
            {% for child in nav.children %}
              <li><a href="{{ child.url | relative_url }}"{% if child.url == page.url %} class="active"{% endif %}>{{ child.title }}</a></li>
            {% endfor %}
          </ul>
        </details>
        {% else %}
        {% if nav.url %}
          <a href="{{ nav.url | relative_url }}"{% if nav.url == page.url %} class="active"{% endif %}><span class="nav__sub-title">{{ nav.title }}</span></a>
        {% else %}
          <span class="nav__sub-title">{{ nav.title }}</span>
        {% endif %}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
<script>
  // Long docs sidebars: bring the current page's link into view inside the
  // sidebar (not the page) so readers can see where they are.
  (function () {
    var nav = document.currentScript.previousElementSibling;
    var link = nav && nav.querySelector('a.active');
    if (!link) return;
    var box = nav.closest('.sidebar') || nav;
    var linkTop = link.getBoundingClientRect().top - box.getBoundingClientRect().top + box.scrollTop;
    if (box.scrollHeight > box.clientHeight) box.scrollTop = Math.max(0, linkTop - box.clientHeight / 3);
  })();
</script>
