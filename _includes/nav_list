{% assign navigation = site.data.navigation[include.nav] %}
{%- comment -%}
  The Finance Toolkit docs sidebars get their own treatment (nav__list--docs):
  a module switcher that names the current module, groups with a count that
  only open when they hold the current page (or when there is a single group),
  and plain links. Other sidebars keep the original behaviour.
{%- endcomment -%}
{% assign docs_nav = false %}
{% if include.nav contains "financetoolkit-docs" %}{% assign docs_nav = true %}{% endif %}
{% if docs_nav %}
  {% assign page_has_active = false %}
  {% assign group_count = 0 %}
  {% for nav in navigation %}
    {% if nav.url == page.url %}{% assign page_has_active = true %}{% endif %}
    {% if nav.children != null and nav.title != "Modules" %}
      {% assign group_count = group_count | plus: 1 %}
      {% for child in nav.children %}{% if child.url == page.url %}{% assign page_has_active = true %}{% endif %}{% endfor %}
    {% endif %}
  {% endfor %}
{% endif %}

<nav class="nav__list{% if docs_nav %} nav__list--docs{% endif %}">
  {% if page.sidebar.title %}<h3 class="nav__title" style="padding-left: 0;">{{ page.sidebar.title }}</h3>{% endif %}
  {% if page.sidebar.hint %}<p class="nav__hint"><i class="fas fa-list-ul" aria-hidden="true"></i> {{ page.sidebar.hint }}</p>{% endif %}
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ page.sidebar.menu_label | default: site.data.ui-text[site.locale].menu_label | default: "Toggle Menu" }}</label>
  <ul class="nav__items">
    {% for nav in navigation %}
      <li{% if docs_nav %} class="{% if nav.children != null %}nav__group{% else %}nav__single{% endif %}"{% endif %}>
        {% if nav.children != null %}
        {% if docs_nav and nav.title == "Modules" %}
          {% assign module_url = page.docs_module_url | default: page.url %}
          {% assign current_module = nav.children | where: "url", module_url | first %}
          <details class="nav__collapsible nav__collapsible--modules nav__module-switch">
            <summary class="nav__collapsible-title">
              <span class="nav__module-label">Module</span>
              <span class="nav__module-name">{{ current_module.title | default: "All modules" }}</span>
            </summary>
            <ul>
              {% for child in nav.children %}
                <li><a href="{{ child.url | relative_url }}"{% if child.url == module_url %} class="active"{% endif %}>{{ child.title }}</a></li>
              {% endfor %}
            </ul>
          </details>
        {% else %}
          {% assign group_open = true %}
          {% if docs_nav %}
            {% assign group_has_active = false %}
            {% for child in nav.children %}{% if child.url == page.url %}{% assign group_has_active = true %}{% endif %}{% endfor %}
            {% unless group_has_active or page_has_active == false and group_count <= 1 %}{% assign group_open = false %}{% endunless %}
          {% endif %}
          {% if nav.title == "Modules" %}{% assign group_open = false %}{% endif %}
          <details class="nav__collapsible{% if nav.title == "Modules" %} nav__collapsible--modules{% endif %}"{% if group_open %} open{% endif %}>
            {% if nav.url and docs_nav == false %}
              <summary class="nav__sub-title nav__collapsible-title"><a href="{{ nav.url | relative_url }}">{{ nav.title }}</a></summary>
            {% else %}
              <summary class="nav__sub-title nav__collapsible-title">{{ nav.title }}{% if docs_nav %}<span class="nav__count">{{ nav.children | size }}</span>{% endif %}</summary>
            {% endif %}
            <ul>
              {% for child in nav.children %}
                <li><a href="{{ child.url | relative_url }}"{% if child.url == page.url %} class="active"{% endif %}>{{ child.title }}</a></li>
              {% endfor %}
            </ul>
          </details>
        {% endif %}
        {% else %}
        {% if nav.url %}
          <a href="{{ nav.url | relative_url }}"{% if nav.url == page.url %} class="active"{% endif %}><span class="nav__sub-title">{{ nav.title }}</span></a>
        {% else %}
          <span class="nav__sub-title">{{ nav.title }}</span>
        {% endif %}
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
<script>
  // Long docs sidebars: bring the current page's link into view inside the
  // sidebar (not the page) so readers can see where they are.
  (function () {
    var nav = document.currentScript.previousElementSibling;
    var link = nav && Array.prototype.find.call(nav.querySelectorAll('a.active'), function (a) {
      return !a.closest('.nav__module-switch'); // the current module is not "where you are"
    });
    if (!link) return;
    var box = nav.closest('.sidebar') || nav;
    var linkTop = link.getBoundingClientRect().top - box.getBoundingClientRect().top + box.scrollTop;
    if (box.scrollHeight > box.clientHeight) box.scrollTop = Math.max(0, linkTop - box.clientHeight / 3);
  })();
</script>
